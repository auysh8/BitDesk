PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/BitDesk?retryWrites=true&w=majority

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# OTP Settings
OTP_EXPIRES_MINUTES=10

# Redis (BullMQ queues & caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email / Google Apps Script Relay (HTTPS Webhook)
GMAIL_RELAY_URL=https://script.google.com/macros/s/<YOUR_SCRIPT_ID>/exec

# Email / SMTP (Nodemailer fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="BitDesk Support <support@yourdomain.com>"
