{
  "info": {
    "_postman_id": "bitdesk-enterprise-api-v1",
    "name": "BitDesk Enterprise API Collection",
    "description": "Production Postman Collection for BitDesk Full-Stack Ticketing & 2-Way Email Support System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"customer@bitdesk.dev\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@bitdesk.dev\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-otp"] }
          }
        },
        {
          "name": "Login (Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bitdesk.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login-password"] }
          }
        },
        {
          "name": "Request Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bitdesk.dev\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login-otp"] }
          }
        },
        {
          "name": "Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bitdesk.dev\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-login-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-login-otp"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh-token"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DevOps & Infrastructure\",\n  \"description\": \"Server and cloud deployment queries\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        }
      ]
    },
    {
      "name": "3. Tickets",
      "item": [
        {
          "name": "List Tickets (with Filters & Sorting)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?page=1&limit=10&sortBy=newest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "newest" }
              ]
            }
          }
        },
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "  pm.collectionVariables.set('ticketId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Network latency spike observed\",\n  \"description\": \"Latency increased by 200ms on the US-East server cluster since 14:00 UTC.\",\n  \"category\": \"Technical Support\",\n  \"priority\": \"High\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] }
          }
        },
        {
          "name": "Get Ticket by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}"] }
          }
        },
        {
          "name": "Update Ticket (Status / Priority)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"priority\": \"Urgent\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}"] }
          }
        },
        {
          "name": "Assign Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"<AGENT_USER_ID>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "assign"] }
          }
        },
        {
          "name": "Resolve Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/resolve", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "resolve"] }
          }
        },
        {
          "name": "Close Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/close", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "close"] }
          }
        },
        {
          "name": "Reopen Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/reopen", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "reopen"] }
          }
        },
        {
          "name": "Get Activity Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/activity", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "activity"] }
          }
        }
      ]
    },
    {
      "name": "4. Messages & Notes",
      "item": [
        {
          "name": "List Ticket Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "messages"] }
          }
        },
        {
          "name": "Post Public Reply",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"We have investigated and deployed a hotfix to routing node 3.\",\n  \"type\": \"public\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "messages"] }
          }
        },
        {
          "name": "Post Internal Note (Staff Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Reviewing upstream transit provider logs with DevOps.\",\n  \"type\": \"internal\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "messages"] }
          }
        }
      ]
    },
    {
      "name": "5. Dashboard",
      "item": [
        {
          "name": "Get Summary Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "summary"] }
          }
        }
      ]
    },
    {
      "name": "6. Inbound Email Webhook",
      "item": [
        {
          "name": "Inbound Email Webhook",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"customer@bitdesk.dev\",\n  \"to\": \"support@bitdesk.dev\",\n  \"subject\": \"Re: [TKT-2026-000001] Network latency spike observed\",\n  \"body\": \"Thank you, the connection has stabilized on our end!\",\n  \"messageId\": \"<msg-test-12345@mail.example.com>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/email/inbound", "host": ["{{baseUrl}}"], "path": ["api", "email", "inbound"] }
          }
        }
      ]
    }
  ]
}
